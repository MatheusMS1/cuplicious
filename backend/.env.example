# Copie este arquivo para ".env" e preencha. Nunca envie o .env ao GitHub.
ADMIN_KEY=troque-por-uma-senha-forte

# Opcional no seu computador: sem estas duas linhas, o banco é o arquivo local cuplicious.db.
# Na hospedagem (Render), cadastre estas variáveis no painel do serviço.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=cole-o-token-aqui

# Só na hospedagem: endereço do site na Netlify (libera apenas ele no CORS).
# FRONTEND_URL=https://seu-site.netlify.app
